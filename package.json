{
  "name": "snail-doctor",
  "displayName": "Snail Doctor",
  "description": "Find out what's slowing down your VS Code.",
  "version": "0.1.0",
  "publisher": "zephfiro",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:snail.diagnose",
    "onCommand:snail.exportReport",
    "onCommand:snail.investigateSuspect",
    "onCommand:snail.investigateTypeScript",
    "onCommand:snail.recordBaseline",
    "onCommand:snail.recordComparison",
    "onCommand:snail.clearExperimentData",
    "onStartupFinished",
    "onCommand:snail.startWatch",
    "onCommand:snail.stopWatch",
    "onCommand:snail.toggleWatch",
    "onCommand:snail.openWatchSessions",
    "onCommand:snail.exportWatchSession",
    "onCommand:snail.clearWatchHistory"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snail.diagnose",
        "title": "Snail: Diagnose Performance"
      },
      {
        "command": "snail.exportReport",
        "title": "Snail: Export Last Report"
      },
      {
        "command": "snail.investigateSuspect",
        "title": "Snail: Investigate a Performance Suspect"
      },
      {
        "command": "snail.investigateTypeScript",
        "title": "Snail: Investigate TypeScript Language Server"
      },
      {
        "command": "snail.recordBaseline",
        "title": "Snail: Record Baseline"
      },
      {
        "command": "snail.recordComparison",
        "title": "Snail: Record Comparison"
      },
      {
        "command": "snail.clearExperimentData",
        "title": "Snail: Clear Experiment Data"
      },
      {
        "command": "snail.startWatch",
        "title": "Snail: Start Watch"
      },
      {
        "command": "snail.stopWatch",
        "title": "Snail: Stop Watch"
      },
      {
        "command": "snail.toggleWatch",
        "title": "Snail: Toggle Watch"
      },
      {
        "command": "snail.openWatchSessions",
        "title": "Snail: Open Watch Sessions"
      },
      {
        "command": "snail.exportWatchSession",
        "title": "Snail: Export Watch Session"
      },
      {
        "command": "snail.clearWatchHistory",
        "title": "Snail: Clear Watch History"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts src/diagnostics.ts src/workspace-scan.ts src/report-view.ts src/report-export.ts src/core/index.ts src/doctor/index.ts src/watch/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outdir=dist",
    "watch": "npm run build -- --watch",
    "lint": "tsc --noEmit",
    "test": "npm run build && npm run test:unit",
    "package": "npm run build && vsce package --no-dependencies",
    "test:unit": "node --test test/smoke.test.cjs test/unit/*.test.cjs",
    "test:integration": "node test/integration/run.cjs",
    "benchmark": "npm run build && node scripts/benchmark.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@vscode/test-electron": "^2.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zephfiro/snail.git"
  },
  "bugs": {
    "url": "https://github.com/zephfiro/snail/issues"
  },
  "homepage": "https://github.com/zephfiro/snail#readme"
}
